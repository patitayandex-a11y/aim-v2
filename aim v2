local flyConn, flyLV, flyAttachment, noclipConn

local function StartFly()
    if flyConn then return end
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local attachment = Instance.new("Attachment", hrp)
    local lv = Instance.new("LinearVelocity")
    lv.Attachment0 = attachment
    lv.MaxForce = math.huge
    lv.VectorVelocity = Vector3.zero
    lv.RelativeTo = Enum.ActuatorRelativeTo.World
    lv.Parent = hrp
    flyLV = lv
    flyAttachment = attachment

    flyConn = RunService.RenderStepped:Connect(function()
        if not flyLV or not flyLV.Parent or not hrp or not hrp.Parent then return end
        local m = Vector3.zero
        local cf = Camera.CFrame
        if UIS:IsKeyDown(Enum.KeyCode.W) then m = m + cf.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.S) then m = m - cf.LookVector end
        if UIS:IsKeyDown(Enum.KeyCode.A) then m = m - cf.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.D) then m = m + cf.RightVector end
        if UIS:IsKeyDown(Enum.KeyCode.Space) then m = m + Vector3.new(0, 1, 0) end
        if UIS:IsKeyDown(Enum.KeyCode.LeftControl) then m = m - Vector3.new(0, 1, 0) end
        flyLV.VectorVelocity = m * Settings.FlySpeed
    end)
end

local function StopFly()
    if flyConn then flyConn:Disconnect(); flyConn = nil end
    if flyLV then flyLV:Destroy(); flyLV = nil end
    if flyAttachment then flyAttachment:Destroy(); flyAttachment = nil end
end

local function ApplyNoclipTo(char)
    if not char then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") and p.CanCollide then p.CanCollide = false end
    end
end

local function StartNoclip()
    if noclipConn then return end
    local char = LP.Character
    if char then ApplyNoclipTo(char) end
    noclipConn = RunService.Stepped:Connect(function()
        local c = LP.Character
        if c then ApplyNoclipTo(c) end
    end)
end

local function StopNoclip()
    if noclipConn then noclipConn:Disconnect(); noclipConn = nil end
end

local fovLastSize = -1
local fovLastVisible = false
local fovLastX, fovLastY = -1, -1

local aimlockConn = RunService.RenderStepped:Connect(function()
    if not Settings.AimLockEnabled or isDestroyed then
        AimLock.Active = false
        AimLock.Target = nil
        AimLock.LockedPlayer = nil
        return
    end

    local keyHeld = false
    local keyEnum = GetKeyEnum(Settings.AimLockKey)
    if keyEnum then
        if typeof(keyEnum) == "EnumItem" and keyEnum.EnumType == Enum.KeyCode then
            keyHeld = UIS:IsKeyDown(keyEnum)
        elseif typeof(keyEnum) == "EnumItem" and keyEnum.EnumType == Enum.UserInputType then
            keyHeld = UIS:IsMouseButtonPressed(keyEnum)
        end
    end

    local shouldAim = false
    if Settings.AimLockMode == "Toggle" then
        shouldAim = AimLock.ToggleState
    else
        shouldAim = keyHeld
    end

    if not shouldAim then
        AimLock.Active = false
        AimLock.Target = nil
        AimLock.LockedPlayer = nil
        return
    end

    local locked = AimLock.LockedPlayer
    local lockedValid = false
    local lockedPart = nil

    if locked then
        if locked.Parent and locked.Character then
            local hum = locked.Character:FindFirstChildOfClass("Humanoid")
            local part = locked.Character:FindFirstChild(Settings.AimbotHitbox)
            if hum and hum.Health > 0 and part then
                lockedValid = true
                lockedPart = part
            end
        end
    end

    if not lockedValid then
        local newTarget = GetTarget()
        if newTarget and newTarget.Parent then
            local newPlr = Players:GetPlayerFromCharacter(newTarget.Parent)
            if newPlr then
                AimLock.LockedPlayer = newPlr
                AimLock.Target = newTarget
            end
        else
            AimLock.Target = nil
            AimLock.LockedPlayer = nil
            AimLock.Active = false
            return
        end
    else
        AimLock.Target = lockedPart
        AimLock.LockedPlayer = locked
    end

    local target = AimLock.Target
    if target and target.Parent then
        AimLock.Active = true

        local cam = Camera
        local camPos = cam.CFrame.Position
        local targetCF = CFrame.new(camPos, target.Position)
        local alpha = math.clamp(Settings.AimLockSmoothness / 100, 0.01, 1)
        local newCF = cam.CFrame:Lerp(targetCF, alpha)

        pcall(function() cam.CFrame = newCF end)

        pcall(function()
            if mousemoverel then
                local currentLook = cam.CFrame.LookVector
                local targetLook = targetCF.LookVector
                local dx = (targetLook.X - currentLook.X) * 500 * alpha
                local dy = (targetLook.Y - currentLook.Y) * 500 * alpha
                mousemoverel(dx, dy)
            end
        end)
    end
end)

local aimbotConn = RunService.RenderStepped:Connect(function()
    local wantVisible = (Settings.AimbotShowFOV and Settings.AimbotEnabled)
        or (Settings.AimLockShowFOV and Settings.AimLockEnabled and AimLock.Active)

    if wantVisible then
        if not fovLastVisible then FOVCircle.Visible = true; fovLastVisible = true end
        local size = Settings.AimbotFOV * 2
        if size ~= fovLastSize then
            FOVCircle.Size = UDim2.new(0, size, 0, size)
            fovLastSize = size
        end
        local mLoc = UIS:GetMouseLocation()
        if mLoc.X ~= fovLastX or mLoc.Y ~= fovLastY then
            FOVCircle.Position = UDim2.new(0, mLoc.X, 0, mLoc.Y)
            fovLastX, fovLastY = mLoc.X, mLoc.Y
        end

        if AimLock.Active then
            FOVStroke.Color = Color3.fromRGB(255, 80, 80)
        else
            FOVStroke.Color = Colors.Accent
        end
    else
        if fovLastVisible then FOVCircle.Visible = false; fovLastVisible = false end
    end

    if Settings.AimbotEnabled and not AimLock.Active then
        local t = GetTarget()
        if t then AimAt(t) end
    end
end)

