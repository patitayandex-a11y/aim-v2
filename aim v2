local function ParseIgnoreList()
    local list = {}
    if not Settings.AimbotIgnoreList or Settings.AimbotIgnoreList == "" then return list end
    for n in string.gmatch(Settings.AimbotIgnoreList, "[^,]+") do
        local t = n:match("^%s*(.-)%s*$")
        if t and t ~= "" then table.insert(list, string.lower(t)) end
    end
    return list
end

local function IsIgnored(plr)
    local list = ParseIgnoreList()
    if #list == 0 then return false end
    local nl, dl = string.lower(plr.Name), string.lower(plr.DisplayName)
    for _, ig in ipairs(list) do if nl == ig or dl == ig then return true end end
    return false
end

local function IsVisible(targetPart, targetChar)
    if not Settings.AimbotVisibilityCheck then return true end
    local myChar = LP.Character
    if not myChar then return true end
    local myHead = myChar:FindFirstChild("Head")
    if not myHead then return true end

    local rp = RaycastParams.new()
    rp.FilterType = Enum.RaycastFilterType.Exclude
    rp.FilterDescendantsInstances = {myChar}
    rp.IgnoreWater = true

    local checkPoints = {targetPart.Position}
    local head = targetChar:FindFirstChild("Head")
    local torso = targetChar:FindFirstChild("UpperTorso") or targetChar:FindFirstChild("Torso")
    if head then table.insert(checkPoints, head.Position) end
    if torso then table.insert(checkPoints, torso.Position) end

    for _, point in ipairs(checkPoints) do
        local res = workspace:Raycast(myHead.Position, point - myHead.Position, rp)
        if not res or (res.Instance and res.Instance:IsDescendantOf(targetChar)) then
            return true
        end
    end
    return false
end

local function GetTarget()
    local best, bestVal = nil, math.huge
    local mLoc = UIS:GetMouseLocation()
    local center = Vector2.new(mLoc.X, mLoc.Y - GUI_INSET)
    local myChar = LP.Character
    if not myChar then return nil end
    local myRoot = myChar:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character and plr.Character:FindFirstChild("Humanoid") and plr.Character.Humanoid.Health > 0 and not IsIgnored(plr) then
            local part = plr.Character:FindFirstChild(Settings.AimbotHitbox)
            if part then
                local sp, on = Camera:WorldToViewportPoint(part.Position)
                if on then
                    local d = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                    if d <= Settings.AimbotFOV and IsVisible(part, plr.Character) then
                        local v = Settings.AimbotTargetPriority == "Closest" and (myRoot.Position - part.Position).Magnitude or d
                        if v < bestVal then bestVal = v; best = part end
                    end
                end
            end
        end
    end
    return best
end

local function AimAt(target)
    if not target then return end
    local cam = Camera
    local camPos = cam.CFrame.Position
    local targetCF = CFrame.new(camPos, target.Position)
    local newCF = cam.CFrame:Lerp(targetCF, Settings.AimbotSmoothness / 100)

    pcall(function() cam.CFrame = newCF end)

    pcall(function()
        if mousemoverel then
            local currentLook = cam.CFrame.LookVector
            local targetLook = targetCF.LookVector
            local dx = (targetLook.X - currentLook.X) * 500 * (Settings.AimbotSmoothness / 100)
            local dy = (targetLook.Y - currentLook.Y) * 500 * (Settings.AimbotSmoothness / 100)
            mousemoverel(dx, dy)
        end
    end)
end

