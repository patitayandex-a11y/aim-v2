        for _, plr in ipairs(Players:GetPlayers()) do
            if myToken ~= headRefreshToken then return end
            if plr ~= LP then
                if Settings.HeadHitboxEnabled and Settings.HeadHitboxScale > 1 then
                    ApplyHead(plr)
                else
                    ResetHead(plr)
                end
            end
            task.wait()
        end
    end)
end

local Hooked = {}

local function WaitForChar(plr, timeout)
    timeout = timeout or 15
    local start = tick()
    while tick() - start < timeout do
        local char = plr.Character
        if char and char:FindFirstChildOfClass("Humanoid") and char:FindFirstChild("Head") and char:FindFirstChildOfClass("Humanoid").Health > 0 then
            return char
        end
        task.wait(0.1)
    end
    return nil
end

local function HookPlayer(plr)
    if plr == LP or Hooked[plr] then return end
    Hooked[plr] = true

    plr.CharacterAdded:Connect(function(char)
        task.spawn(function()
            local hum = char:WaitForChild("Humanoid", 10)
            if hum then
                hum.Died:Connect(function()
                    RemoveESP(plr)
                    ResetHead(plr)
                end)
            end
            local ok = WaitForChar(plr)
            if ok then
                RemoveESP(plr)
                AddESP(plr)
                if Settings.HeadHitboxEnabled and Settings.HeadHitboxScale > 1 then
                    ApplyHead(plr)
                end
            end
        end)
    end)

    if plr.Character then
        task.spawn(function()
            local char = WaitForChar(plr, 5)
            if char then
                RemoveESP(plr)
                AddESP(plr)
                if Settings.HeadHitboxEnabled and Settings.HeadHitboxScale > 1 then
                    ApplyHead(plr)
                end
            end
        end)
    end
end

for _, plr in ipairs(Players:GetPlayers()) do
