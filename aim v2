local function AddRipple(btn)
    btn.ClipsDescendants = true
    btn.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 then return end
        if not btn.Parent then return end
        local rel = Vector2.new(input.Position.X - btn.AbsolutePosition.X, input.Position.Y - btn.AbsolutePosition.Y)
        local r = Instance.new("Frame")
        r.AnchorPoint = Vector2.new(0.5, 0.5)
        r.Position = UDim2.new(0, rel.X, 0, rel.Y)
        r.Size = UDim2.new(0, 0, 0, 0)
        r.BackgroundColor3 = Color3.new(1, 1, 1)
        r.BackgroundTransparency = 0.75
        r.BorderSizePixel = 0
        r.ZIndex = 5
        r.Parent = btn
        Instance.new("UICorner", r).CornerRadius = UDim.new(1, 0)
        local size = math.max(btn.AbsoluteSize.X, btn.AbsoluteSize.Y) * 2.2
        local t = TweenService:Create(r, TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, size, 0, size),
            BackgroundTransparency = 1,
        })
        t:Play()
        t.Completed:Connect(function() if r then r:Destroy() end end)
    end)
end

