local HeadOrig = {}

local function ResetHead(plr)
    local d = HeadOrig[plr]
    if d then
        if d.Part and d.Part.Parent then
            pcall(function() d.Part.Size = d.Size end)
        end
        HeadOrig[plr] = nil
    end
end

local function ApplyHead(plr)
    if plr == LP then return end
    local char = plr.Character
    if not char then ResetHead(plr); return end
    local head = char:FindFirstChild("Head")
    if not head then ResetHead(plr); return end

    if not Settings.HeadHitboxEnabled or Settings.HeadHitboxScale <= 1 then
        ResetHead(plr)
        return
    end

    if not HeadOrig[plr] or HeadOrig[plr].Part ~= head then
        HeadOrig[plr] = {Part = head, Size = head.Size}
    end

    local targetSize = HeadOrig[plr].Size * Settings.HeadHitboxScale
    if head.Size ~= targetSize then
        pcall(function() head.Size = targetSize end)
    end
end

