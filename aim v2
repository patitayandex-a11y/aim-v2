local Settings = {}

local function MergeSettings(data)
    for k, v in pairs(Defaults) do
        local val = data[k]
        if val == nil then Settings[k] = v
        elseif type(val) == type(v) then Settings[k] = val
        else Settings[k] = v end
    end
end

local function LoadSettings()
    if isfile(FILE) then
        local ok, data = pcall(function() return HttpService:JSONDecode(readfile(FILE)) end)
        if ok and type(data) == "table" then MergeSettings(data); return end
    end
    for k, v in pairs(Defaults) do Settings[k] = v end
end

local function SaveSettings()
    local ok, enc = pcall(function() return HttpService:JSONEncode(Settings) end)
    if ok then pcall(function() writefile(FILE, enc) end) end
end

local saveQueued = false
