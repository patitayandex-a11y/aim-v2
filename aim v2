local function SanitizeName(name)
    name = tostring(name or "")
    name = name:gsub("[<>:\"/\\|%?%*]", "")
    name = name:gsub("^%s+", ""):gsub("%s+$", "")
    return name
end

local function ConfigPath(name) return CONFIG_FOLDER .. "/" .. name .. ".json" end

local function GetConfigList()
    local list = {}
    local ok, files = pcall(function() return listfiles(CONFIG_FOLDER) end)
    if not ok or type(files) ~= "table" then return list end
    for _, path in ipairs(files) do
        local n = tostring(path):match("([^/\\]+)%.json$")
        if n then table.insert(list, n) end
    end
    table.sort(list)
    return list
end

local function SaveConfig(name)
    name = SanitizeName(name)
    if name == "" then return false, "Пустое имя" end
    local ok, enc = pcall(function() return HttpService:JSONEncode(Settings) end)
    if not ok or not enc then return false, "Ошибка JSON" end
    local ok2 = pcall(function() writefile(ConfigPath(name), enc) end)
    if not ok2 then return false, "Ошибка записи" end
    return true
end

local function LoadConfig(name)
    name = SanitizeName(name)
    if name == "" then return false, "Пустое имя" end
    if not isfile(ConfigPath(name)) then return false, "Не найден" end
    local ok, data = pcall(function() return HttpService:JSONDecode(readfile(ConfigPath(name))) end)
    if not ok or type(data) ~= "table" then return false, "Повреждён" end
    MergeSettings(data)
    return true
end

local function DeleteConfig(name)
    name = SanitizeName(name)
    if name == "" then return false end
    if not isfile(ConfigPath(name)) then return false end
    return pcall(function() delfile(ConfigPath(name)) end)
end

