local dragging, dragStart, startPos = false, nil, nil
TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging, dragStart, startPos = true, input.Position, MainFrame.Position
    end
end)
Track(UIS.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local d = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
    end
end))
Track(UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
end))

local function DestroyEverything()
    if isDestroyed then return end
    isDestroyed = true
    Settings.AimbotEnabled, Settings.ESPEnabled, Settings.NameESPEnabled = false, false, false
    Settings.HealthESPEnabled, Settings.DistanceESPEnabled, Settings.FullbrightEnabled = false, false, false
    Settings.SpeedEnabled, Settings.JumpEnabled, Settings.InfJumpEnabled = false, false, false
    Settings.FlyEnabled, Settings.NoclipEnabled = false, false
    Settings.HeadHitboxEnabled = false
    Settings.AimLockEnabled = false
    AimLock.Active = false
    AimLock.Target = nil
    AimLock.LockedPlayer = nil
    AimLock.ToggleState = false
    Menu.WaitingForBind = nil
    Hooked = {}
    for plr, _ in pairs(HeadOrig) do ResetHead(plr) end
    if aimbotConn then aimbotConn:Disconnect(); aimbotConn = nil end
    if aimlockConn then aimlockConn:Disconnect(); aimlockConn = nil end
    DisconnectAll()
    StopFly()
    StopNoclip()
    ClearESPTable()
    ApplyFullbright()
    local h = GetHum()
    if h then h.WalkSpeed = 16; h.UseJumpPower = true; h.JumpPower = 50 end
    if FOVCircle then FOVCircle.Visible = false end
    SaveSettings()
    if FOVGui then FOVGui:Destroy() end
    local t = TweenService:Create(MainFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
        Size = UDim2.new(0, 0, 0, 0), Position = UDim2.new(0.5, 0, 0.5, 0), BackgroundTransparency = 1
    })
    t:Play()
    Notify("Меню уничтожено")
    task.wait(0.4)
    if ScreenGui then ScreenGui:Destroy() end
end

Track(UIS.InputBegan:Connect(function(input, gp)
    if gp then return end
    if input.KeyCode == Enum.KeyCode.Insert and not isDestroyed then ToggleMenu() end
    if input.KeyCode == Enum.KeyCode.Delete then DestroyEverything() end
end))

Track(UIS.InputBegan:Connect(function(input, gp)
    if gp or isDestroyed then return end
    if Menu.WaitingForBind then
        local k
        if input.KeyCode ~= Enum.KeyCode.Unknown then k = input.KeyCode.Name
        elseif input.UserInputType == Enum.UserInputType.MouseButton1 then k = "Mouse1"
        elseif input.UserInputType == Enum.UserInputType.MouseButton2 then k = "Mouse2"
        elseif input.UserInputType == Enum.UserInputType.MouseButton3 then k = "Mouse3" end
        if k then local b = Menu.WaitingForBind; Menu.WaitingForBind = nil; b.Callback(k) end
        return
    end

    if Settings.AimLockEnabled and Settings.AimLockMode == "Toggle" then
        local cur = Settings.AimLockKey
        if cur and cur ~= "None" then
            local k = GetKeyEnum(cur)
            if k then
                local matched = false
                if input.KeyCode == k then matched = true end
                if input.UserInputType == k then matched = true end
                if matched then
                    AimLock.ToggleState = not AimLock.ToggleState
                    if not AimLock.ToggleState then
                        AimLock.Active = false
                        AimLock.Target = nil
                        AimLock.LockedPlayer = nil
                    end
                    Notify(AimLock.ToggleState and "Aim Lock: ON" or "Aim Lock: OFF",
                        AimLock.ToggleState and Color3.fromRGB(80, 220, 120) or Color3.fromRGB(220, 160, 80))
                    return
                end
            end
        end
    end

    for _, item in ipairs(Menu.AllItems) do
        if item.GetBindKey and item.ToggleFunction then
            local cur = item.GetBindKey()
            if cur and cur ~= "None" then
                local k = GetKeyEnum(cur)
                if k then
                    local matched = false
                    if input.KeyCode == k then matched = true end
                    if input.UserInputType == k then matched = true end
                    if matched then item.ToggleFunction() end
                end
            end
        end
    end
end))

